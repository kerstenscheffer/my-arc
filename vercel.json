{
  "functions": {
    "api/*.js": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/betaal/:id",
      "destination": "/api/betaal-verlenging?id=:id"
    },
    {
      "source": "/online-coaching",
      "destination": "/online-coaching.html"
    },
    {
      "source": "/online-coaching-afvallen",
      "destination": "/online-coaching-afvallen.html"
    },
    {
      "source": "/online-coaching-voeding",
      "destination": "/online-coaching-voeding.html"
    },
    {
      "source": "/beste-online-fitness-coaching",
      "destination": "/beste-online-fitness-coaching.html"
    },
    {
      "source": "/buikvet-verliezen-man",
      "destination": "/buikvet-verliezen-man.html"
    },
    {
      "source": "/afvallen-man-40-plus",
      "destination": "/afvallen-man-40-plus.html"
    },
    {
      "source": "/afvallen-met-alcohol",
      "destination": "/afvallen-met-alcohol.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}

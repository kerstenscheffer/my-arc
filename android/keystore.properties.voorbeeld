# Kopieer dit bestand naar android/keystore.properties en vul je eigen waarden in.
# keystore.properties staat in .gitignore en hoort daar te blijven.
#
# Sleutel aanmaken (eenmalig, kies zelf een sterk wachtwoord):
#   keytool -genkey -v -keystore android/myarc-upload.jks \
#     -keyalg RSA -keysize 2048 -validity 10000 -alias myarc-upload
#
# Bewaar het .jks-bestand EN de wachtwoorden ergens buiten dit project.
# Kwijt = nooit meer een update op dezelfde app in de Play Store.

storeFile=myarc-upload.jks
storePassword=VUL_IN
keyAlias=myarc-upload
keyPassword=VUL_IN
